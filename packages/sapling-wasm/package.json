{
  "name": "@taquito/sapling-wasm",
  "version": "0.3.0",
  "description": "Sapling Wasm bindings for Taquito and compatible consumers.",
  "author": "ECAD Labs Inc <info@ecadlabs.com>",
  "license": "MIT",
  "homepage": "https://github.com/ecadlabs/sapling-wasm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecadlabs/sapling-wasm.git",
    "directory": "packages/sapling-wasm"
  },
  "bugs": {
    "url": "https://github.com/ecadlabs/sapling-wasm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "pkg",
    "pkg-web",
    "README.md"
  ],
  "main": "dist/index.node.js",
  "module": "dist/browser/index.js",
  "browser": "dist/browser/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser/index.js",
      "node": "./dist/index.node.js",
      "import": "./dist/browser/index.js",
      "require": "./dist/index.node.js",
      "default": "./dist/browser/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf dist pkg pkg-web",
    "build": "npm run clean && npm run build:node:wasm && npm run build:browser:wasm && npm run normalize:wasm-pack-output && npm run build:node && npm run build:browser && npm run build:types",
    "build:node:wasm": "wasm-pack build ../sapling --target nodejs --out-dir ../sapling-wasm/pkg --out-name index --release -- --locked --features wasm_bindings",
    "build:browser:wasm": "wasm-pack build ../sapling --target web --out-dir ../sapling-wasm/pkg-web --out-name index --release -- --locked --features wasm_bindings",
    "build:node": "tsc --project tsconfig.node.json && node ../../scripts/finalize-node-build.js",
    "build:browser": "tsc --project tsconfig.browser.json",
    "build:types": "tsc --project tsconfig.types.json",
    "normalize:wasm-pack-output": "rimraf pkg/.gitignore pkg-web/.gitignore"
  }
}
